# ReSprout Environment Configuration

# AI Service Configuration (OpenAI or compatible vision API)
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# true forces demo results; false uses OpenAI when a key exists, otherwise demo fallback
DEMO_MODE=false

# Tree Growth Targets
PLEDGE_TARGET_TREE=10
PLEDGE_TARGET_FOREST=50

# Optional Supabase integration (local in-memory store acts as fallback if not set)
SUPABASE_URL=
SUPABASE_ANON_KEY=
